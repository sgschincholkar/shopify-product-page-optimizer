FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

# Hermes installs its managed CLI and Python runtime under /root/.hermes.
RUN curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src
COPY scripts ./scripts
COPY hermes-skills/shopify-pdp-upgrade-audit /root/.hermes/skills/shopify-pdp-upgrade-audit

ENV HOST=0.0.0.0
CMD ["npm", "run", "hermes:adapter"]
